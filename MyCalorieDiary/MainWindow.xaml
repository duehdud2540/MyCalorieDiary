<Window x:Class="MyCalorieDiary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MyCalorieDiary.ViewModels"
        mc:Ignorable="d"
        Title="🥗 My Calorie Diary - 식단 &amp; 칼로리 다이어리" 
        Height="780" Width="1100" 
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header & Date Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Today Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- 1. Top Header & Date Navigation                -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="🥗" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="My Calorie Diary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="오늘 음식 섭취량 &amp; 탄·단·지 칼로리 다이어리" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Date Navigator -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                        CornerRadius="8" Padding="6,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousDayCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="◀ 어제" Padding="8,4" Margin="0,0,6,0" ToolTip="이전 날짜로 이동" />
                        
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Margin="4,0" VerticalAlignment="Center" Width="145"
                                    BorderThickness="0" Background="Transparent"
                                    FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" FontSize="13" />

                        <Button Command="{Binding NextDayCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="내일 ▶" Padding="8,4" Margin="6,0,6,0" ToolTip="다음 날짜로 이동" />

                        <Button Command="{Binding GoToTodayCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                Content="오늘" Padding="10,4"
                                Background="{StaticResource PrimaryLightBrush}" 
                                Foreground="{StaticResource PrimaryBrush}"
                                BorderBrush="#A7F3D0" FontWeight="Bold"
                                ToolTip="오늘 날짜로 바로 이동" />
                    </StackPanel>
                </Border>

                <!-- Right: Daily Calorie Goal Setting -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="일일 목표 칼로리:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DailyCalorieGoal, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Width="75" HorizontalContentAlignment="Right"
                             FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" />
                    <TextBlock Text="kcal" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 2. Daily Nutrition Summary Cards               -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Margin="20,12,20,8" Style="{StaticResource CardBorderStyle}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Total Calories Card -->
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="16" />
                    <!-- Carbs Card -->
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="12" />
                    <!-- Protein Card -->
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="12" />
                    <!-- Fat Card -->
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="16" />
                    <!-- Macro Ratio Breakdown -->
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <!-- Calories Card -->
                <Border Grid.Column="0" Background="{StaticResource CaloriesLightBrush}" CornerRadius="8" Padding="14,10"
                        BorderBrush="#DDD6FE" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <TextBlock Text="🔥 총 섭취 칼로리" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CaloriesBrush}" />
                            <TextBlock Text="{Binding DailySummary.MealCount, StringFormat=' (총 {0}회 섭취)'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="{Binding DailySummary.TotalCalories, StringFormat='{}{0:F0}'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" />
                            <TextBlock Text=" / " FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,4,4" />
                            <TextBlock Text="{Binding DailyCalorieGoal, StringFormat='{}{0:F0} kcal'}" 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>

                        <!-- Progress Bar & Remaining -->
                        <Grid Grid.Row="2">
                            <ProgressBar Height="7" Value="{Binding CalorieProgressPercentage, Mode=OneWay}" 
                                         Maximum="100" Minimum="0" Foreground="{StaticResource CaloriesBrush}" 
                                         Background="#E9D5FF" BorderThickness="0">
                                <ProgressBar.Clip>
                                    <RectangleGeometry Rect="0,0,240,7" RadiusX="3" RadiusY="3" />
                                </ProgressBar.Clip>
                            </ProgressBar>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Carbs Card -->
                <Border Grid.Column="2" Background="{StaticResource CarbsLightBrush}" CornerRadius="8" Padding="12,10"
                        BorderBrush="#BFDBFE" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🌾 탄수화물" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CarbsBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="{Binding DailySummary.TotalCarbs, StringFormat='{}{0:F1}'}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" />
                            <TextBlock Text=" g" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding DailySummary.CarbsCalories, StringFormat='{}{0:F0} kcal 기여'}" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Protein Card -->
                <Border Grid.Column="4" Background="{StaticResource ProteinLightBrush}" CornerRadius="8" Padding="12,10"
                        BorderBrush="#99F6E4" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🥩 단백질" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ProteinBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="{Binding DailySummary.TotalProtein, StringFormat='{}{0:F1}'}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource ProteinBrush}" />
                            <TextBlock Text=" g" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding DailySummary.ProteinCalories, StringFormat='{}{0:F0} kcal 기여'}" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Fat Card -->
                <Border Grid.Column="6" Background="{StaticResource FatLightBrush}" CornerRadius="8" Padding="12,10"
                        BorderBrush="#FDE68A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🥑 지방" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FatBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="{Binding DailySummary.TotalFat, StringFormat='{}{0:F1}'}" 
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource FatBrush}" />
                            <TextBlock Text=" g" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3" />
                        </StackPanel>
                        <TextBlock Text="{Binding DailySummary.FatCalories, StringFormat='{}{0:F0} kcal 기여'}" 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Macro Ratio Breakdown -->
                <Border Grid.Column="8" Background="#F8FAFC" CornerRadius="8" Padding="12,10"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚖️ 탄·단·지 칼로리 비율" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="탄 " FontSize="11" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" />
                            <TextBlock Text="{Binding DailySummary.CarbsPercentage, Converter={StaticResource PctConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" />
                            <TextBlock Text=" : " FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0" />
                            <TextBlock Text="단 " FontSize="11" FontWeight="Bold" Foreground="{StaticResource ProteinBrush}" />
                            <TextBlock Text="{Binding DailySummary.ProteinPercentage, Converter={StaticResource PctConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ProteinBrush}" />
                            <TextBlock Text=" : " FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,0" />
                            <TextBlock Text="지 " FontSize="11" FontWeight="Bold" Foreground="{StaticResource FatBrush}" />
                            <TextBlock Text="{Binding DailySummary.FatPercentage, Converter={StaticResource PctConverter}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FatBrush}" />
                        </StackPanel>
                        <TextBlock Text="권장: 탄 50% · 단 30% · 지 20%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 3. Main Navigation TabControl                  -->
        <!-- ============================================== -->
        <TabControl Grid.Row="2" Margin="20,4,20,10" Background="Transparent" BorderThickness="0">
            
            <!-- ========================================== -->
            <!-- Tab 1: 🍽️ 먹은 음식 입력                      -->
            <!-- ========================================== -->
            <TabItem Header="🍽️ 먹은 음식 입력" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left Input Panel -->
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="16" />
                        <!-- Right Logged Meals List -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Input Form Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="오늘 먹은 음식 등록" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="음식을 드롭다운에서 선택하고 먹은 양을 입력하세요." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                                <!-- 1. Meal Type Selection -->
                                <TextBlock Text="식사 구분" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding MealTypes}" SelectedItem="{Binding MealType}"
                                          Height="36" Margin="0,0,0,16" FontSize="13" VerticalContentAlignment="Center" />

                                <!-- 2. Food Dropdown (Requested: 드롭다운 형식) -->
                                <TextBlock Text="음식 선택 (드롭다운)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding Foods}" SelectedItem="{Binding SelectedFood}"
                                          Height="42" Margin="0,0,0,6" FontSize="13" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding DisplayText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Food Search / Filter helper note -->
                                <TextBlock Text="* 원하는 음식이 없으면 상단 [음식 데이터 등록] 탭에서 추가할 수 있습니다." 
                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,16" />

                                <!-- 3. Portion Amount -->
                                <TextBlock Text="먹은 섭취량 (배수 / 인분)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding IntakeAmount, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Height="36" FontSize="14" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrushColor}" 
                                            BorderThickness="0,1,1,1" CornerRadius="0,6,6,0" Padding="12,0" VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding SelectedFood.ServingUnit, FallbackValue='인분'}" 
                                                   VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Quick Portion Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Command="{Binding SetPortionCommand}" CommandParameter="0.5" 
                                            Style="{StaticResource SecondaryButtonStyle}" Content="0.5인분" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Command="{Binding SetPortionCommand}" CommandParameter="1.0" 
                                            Style="{StaticResource SecondaryButtonStyle}" Content="1.0인분" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Command="{Binding SetPortionCommand}" CommandParameter="1.5" 
                                            Style="{StaticResource SecondaryButtonStyle}" Content="1.5인분" Margin="0,0,6,0" Padding="10,4" />
                                    <Button Command="{Binding SetPortionCommand}" CommandParameter="2.0" 
                                            Style="{StaticResource SecondaryButtonStyle}" Content="2.0인분" Padding="10,4" />
                                </StackPanel>

                                <!-- 4. Real-time Nutritional Preview Card -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⚡ 섭취 시 영양성분 자동 계산 결과" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" Margin="0,0,0,8" />
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Preview Calories -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="칼로리" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding PreviewCalories, StringFormat='{}{0:F0} kcal'}" 
                                                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource CaloriesBrush}" />
                                            </StackPanel>

                                            <!-- Preview Carbs -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="탄수화물" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding PreviewCarbs, StringFormat='{}{0:F1} g'}" 
                                                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource CarbsBrush}" />
                                            </StackPanel>

                                            <!-- Preview Protein -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="단백질" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding PreviewProtein, StringFormat='{}{0:F1} g'}" 
                                                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource ProteinBrush}" />
                                            </StackPanel>

                                            <!-- Preview Fat -->
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="지방" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding PreviewFat, StringFormat='{}{0:F1} g'}" 
                                                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource FatBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Add Meal Button -->
                                <Button Command="{Binding AddMealLogCommand}" Style="{StaticResource PrimaryButtonStyle}" 
                                        Height="44" FontSize="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🍴 " FontSize="14" />
                                        <TextBlock Text="오늘 식단에 추가하기" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Logged Meals for Selected Date -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅 " FontSize="15" />
                                    <TextBlock Text="{Binding FormattedSelectedDate}" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text=" 섭취 내역" FontSize="15" FontWeight="Bold" />
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding TodayMealRecords.Count, StringFormat='총 {0}건'}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Meal Records Table -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding TodayMealRecords}"
                                      AutoGenerateColumns="False" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="시간" Binding="{Binding FormattedTimeOnly}" Width="70" />
                                    <DataGridTemplateColumn Header="구분" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding MealType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="음식명" Binding="{Binding FoodName}" Width="2*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="섭취량" Binding="{Binding PortionDisplay}" Width="80" />
                                    <DataGridTextColumn Header="칼로리" Binding="{Binding TotalCalories, StringFormat='{}{0:F0} kcal'}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="탄수화물" Binding="{Binding TotalCarbs, StringFormat='{}{0:F1} g'}" Width="80" />
                                    <DataGridTextColumn Header="단백질" Binding="{Binding TotalProtein, StringFormat='{}{0:F1} g'}" Width="80" />
                                    <DataGridTextColumn Header="지방" Binding="{Binding TotalFat, StringFormat='{}{0:F1} g'}" Width="80" />
                                    
                                    <!-- Delete Button Column -->
                                    <DataGridTemplateColumn Header="삭제" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="삭제" Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.DeleteMealLogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- Tab 2: ➕ 음식 데이터 등록                     -->
            <!-- ========================================== -->
            <TabItem Header="➕ 음식 데이터 등록" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Form Column -->
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <!-- Database Table Column -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: New Food Form Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="새 음식 영양성분 추가" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="탄·단·지와 칼로리를 입력하면 SQLite 로컬 DB에 영구 저장됩니다." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <!-- Food Name -->
                                <TextBlock Text="음식 이름 *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewFoodName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12" />

                                <!-- Serving Unit -->
                                <TextBlock Text="1회 기준 단위 (예: 인분, 개, 100g 등)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewFoodUnit, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12" />

                                <!-- Nutrients Grid (Carbs, Protein, Fat) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Carbs -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="탄수화물 (g) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CarbsBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewFoodCarbsText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Height="36" HorizontalContentAlignment="Right" />
                                    </StackPanel>

                                    <!-- Protein -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="단백질 (g) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ProteinBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewFoodProteinText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Height="36" HorizontalContentAlignment="Right" />
                                    </StackPanel>

                                    <!-- Fat -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="지방 (g) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FatBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NewFoodFatText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Height="36" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- Calories & Auto-Calculate Button -->
                                <TextBlock Text="칼로리 (kcal)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CaloriesBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding NewFoodCaloriesText, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Height="36" HorizontalContentAlignment="Right" FontWeight="Bold" />
                                    <Button Grid.Column="2" Command="{Binding AutoCalculateNewCaloriesCommand}" 
                                            Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="10,0"
                                            Content="⚡ 탄·단·지 자동 계산" ToolTip="탄수화물(×4) + 단백질(×4) + 지방(×9) 공식으로 칼로리 계산" />
                                </Grid>

                                <!-- Submit Button -->
                                <Button Command="{Binding AddNewFoodCommand}" Style="{StaticResource PrimaryButtonStyle}" 
                                        Height="44" FontSize="14" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="14" />
                                        <TextBlock Text="SQLite 데이터베이스에 저장" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Registered Food Database List -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Search and Title Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📚 등록된 음식 데이터베이스" FontSize="15" FontWeight="Bold" />
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding FilteredFoods.Count, StringFormat='총 {0}종류'}" 
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Search Box -->
                                <TextBox Grid.Column="2" Text="{Binding FoodSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Height="34" Margin="0">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="음식 이름을 검색하여 필터링합니다." />
                                    </TextBox.ToolTip>
                                </TextBox>
                            </Grid>

                            <!-- Foods DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredFoods}"
                                      AutoGenerateColumns="False" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="음식명" Binding="{Binding Name}" Width="2*" FontWeight="Bold" />
                                    <DataGridTextColumn Header="기준 단위" Binding="{Binding ServingUnit}" Width="80" />
                                    <DataGridTextColumn Header="칼로리" Binding="{Binding Calories, StringFormat='{}{0:F0} kcal'}" Width="100" FontWeight="Bold" />
                                    <DataGridTextColumn Header="탄수화물" Binding="{Binding Carbohydrates, StringFormat='{}{0:F1} g'}" Width="90" />
                                    <DataGridTextColumn Header="단백질" Binding="{Binding Protein, StringFormat='{}{0:F1} g'}" Width="90" />
                                    <DataGridTextColumn Header="지방" Binding="{Binding Fat, StringFormat='{}{0:F1} g'}" Width="90" />
                                    
                                    <!-- Delete Food Button -->
                                    <DataGridTemplateColumn Header="관리" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="삭제" Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.DeleteFoodCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Info Note -->
                            <TextBlock Grid.Row="2" Text="* 등록된 음식은 [먹은 음식 입력] 드롭다운에 즉시 반영됩니다." 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- Tab 3: 📅 먹었던 기록 확인 (History & Analysis)-->
            <!-- ========================================== -->
            <TabItem Header="📅 먹었던 기록 확인" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <!-- Filter & Range Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Period Totals Summary -->
                        <RowDefinition Height="Auto" />
                        <!-- History DataGrid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Date Range Presets -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="기간 선택: " VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                <Button Command="{Binding SetHistoryRangePresetCommand}" CommandParameter="Today"
                                        Style="{StaticResource SecondaryButtonStyle}" Content="오늘" Margin="0,0,4,0" Padding="8,4" />
                                <Button Command="{Binding SetHistoryRangePresetCommand}" CommandParameter="7Days"
                                        Style="{StaticResource SecondaryButtonStyle}" Content="최근 7일" Margin="0,0,4,0" Padding="8,4" />
                                <Button Command="{Binding SetHistoryRangePresetCommand}" CommandParameter="30Days"
                                        Style="{StaticResource SecondaryButtonStyle}" Content="최근 30일" Margin="0,0,4,0" Padding="8,4" />
                                <Button Command="{Binding SetHistoryRangePresetCommand}" CommandParameter="All"
                                        Style="{StaticResource SecondaryButtonStyle}" Content="전체" Margin="0,0,12,0" Padding="8,4" />

                                <!-- Custom Date Pickers -->
                                <DatePicker SelectedDate="{Binding HistoryStartDate, Mode=TwoWay}" Width="120" VerticalAlignment="Center" />
                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextMutedBrush}" />
                                <DatePicker SelectedDate="{Binding HistoryEndDate, Mode=TwoWay}" Width="120" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Meal Type Filter & Refresh -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="식사 구분: " VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding HistoryMealFilters}" SelectedItem="{Binding HistoryMealFilter}" 
                                          Width="90" Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Command="{Binding RefreshAllCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                                        Content="🔄 새로고침" Padding="10,4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Period Nutrition Totals Summary -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushColor}" 
                            BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="📊 선택한 기간 총계" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="총 칼로리: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HistoryTotalCalories, StringFormat='{}{0:N0} kcal'}" 
                                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource CaloriesBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="탄수화물: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HistoryTotalCarbs, StringFormat='{}{0:N1} g'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource CarbsBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="단백질: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HistoryTotalProtein, StringFormat='{}{0:N1} g'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource ProteinBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="지방: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding HistoryTotalFat, StringFormat='{}{0:N1} g'}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource FatBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- History DataGrid -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding HistoryRecords}"
                                  AutoGenerateColumns="False" CanUserSortColumns="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="일시" Binding="{Binding FormattedDate}" Width="130" />
                                <DataGridTemplateColumn Header="구분" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding MealType}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="음식명" Binding="{Binding FoodName}" Width="2*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="섭취량" Binding="{Binding PortionDisplay}" Width="85" />
                                <DataGridTextColumn Header="칼로리" Binding="{Binding TotalCalories, StringFormat='{}{0:F0} kcal'}" Width="100" FontWeight="Bold" />
                                <DataGridTextColumn Header="탄수화물" Binding="{Binding TotalCarbs, StringFormat='{}{0:F1} g'}" Width="90" />
                                <DataGridTextColumn Header="단백질" Binding="{Binding TotalProtein, StringFormat='{}{0:F1} g'}" Width="90" />
                                <DataGridTextColumn Header="지방" Binding="{Binding TotalFat, StringFormat='{}{0:F1} g'}" Width="90" />
                                
                                <!-- Delete Button Column -->
                                <DataGridTemplateColumn Header="기록 삭제" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="삭제" Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.DeleteMealLogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================== -->
        <!-- 4. Bottom Status Bar                           -->
        <!-- ============================================== -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status / Feedback Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="상태: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding FoodStatusMessage, FallbackValue='준비 완료'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>

                <!-- SQLite DB Storage Location -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💾 로컬 DB 저장 경로: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DbFilePath}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Command="{Binding OpenDbFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" 
                            Content="📂 DB 폴더 열기" Padding="6,2" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
